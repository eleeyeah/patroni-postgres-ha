#
# Ignore secrets, credentials, and generated material
# (patterns are relative to this patroni-postgres-ha/ folder)

# Env / secret overlays
secrets/
*.secret.yaml
*-secrets.yaml
**/secret-overrides.yaml
.env
.env.*
!.env.example

# Kubernetes credentials (if copied into this tree by mistake)
kubeconfig
kubeconfig.*
.kube/
*.pem
*.key
!*.pub

# SSH keys accidentally copied here
id_rsa
id_ed25519
*_rsa
*_ed25519

# Helm packages
*.tgz
charts/

# Terraform
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/crash.log
**/*.tfvars
!**/*.tfvars.example
**/.terraform.lock.hcl

# OS / editor noise
.DS_Store
*.swp
.idea/
.vscode/
